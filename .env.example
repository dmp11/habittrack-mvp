# Скопируйте в .env и при необходимости измените значения.

# Основное
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000/api
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# База данных. Если DATABASE_URL не задан, используется локальный SQLite (data/habittrack.db).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/habittrack
SQLITE_PATH=data/habittrack.db

# Почта (SMTP). Без настроек письма выводятся в консоль и data/emails.log в режиме разработки.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HabitTrack <noreply@habittrack.local>"

# Web Push (опционально). Ключи генерируются командой: npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@habittrack.local

# Дополнительно
RATE_LIMIT_TRUST_PROXY=false
